#include "DefaultAppsPageRes.h"
#include "../../GuiCommon.rc"
#undef MY_FONT
#define MY_FONT FONT 9, "Segoe UI"
#define xc 320
#define yc 250

IDD_DEFAULT_APPS MY_PAGE
CAPTION "File types"
BEGIN
  LTEXT "Choose what ExcellentZip opens", -1, m, 8, 320, 14
  LTEXT "Windows asks you to confirm default apps. Choose all supported types, or select specific extensions.", -1, m, 26, 320, 21
  PUSHBUTTON "&All file types...", IDB_DEFAULTS_ALL, m, 49, 112, 18
  LTEXT "&Extensions (for example zip, 7z, rar):", -1, m, 74, 320, 11
  EDITTEXT IDE_DEFAULTS_EXTENSIONS, m, 89, 242, 18, ES_AUTOHSCROLL
  PUSHBUTTON "Use &list", IDB_DEFAULTS_FROM_TEXT, 258, 89, 70, 18
  PUSHBUTTON "&Select all", IDB_DEFAULTS_SELECT_ALL, m, 113, 62, 17
  PUSHBUTTON "&Clear", IDB_DEFAULTS_CLEAR, m+68, 113, 52, 17
  PUSHBUTTON "&Refresh", IDB_DEFAULTS_REFRESH, 266, 113, 62, 17
  CONTROL "", IDC_DEFAULTS_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, m, 135, 320, 66
  LTEXT "Select file types to begin.", IDT_DEFAULTS_STATUS, m, 207, 320, 25
  PUSHBUTTON "Choose &selected...", IDB_DEFAULTS_CHOOSE, m, 239, 120, 19
  PUSHBUTTON "Stop", IDB_DEFAULTS_STOP, m+128, 239, 56, 19
END
