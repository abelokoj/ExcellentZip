            -->
            <desktop4:ItemType Type="*">
              <desktop4:Verb Id="0000ExcellentZipShellExtension" Clsid="9F7D3F51-2EB6-4D4C-87A5-E985BD9E0E21" />
            </desktop4:ItemType>
            <desktop5:ItemType Type="Directory">
